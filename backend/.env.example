PORT=4000
NODE_ENV=production
CORS_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/certificate_portal

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=replace-with-a-strong-secret
